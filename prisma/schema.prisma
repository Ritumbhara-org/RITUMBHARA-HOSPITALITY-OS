generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UnitStatus {
  AVAILABLE
  OCCUPIED
  DIRTY
  CLEANING
  READY
  MAINTENANCE
}

enum TicketCategory {
  MAINTENANCE
  HOUSEKEEPING
  GUEST_REQUEST
  GUEST_COMPLAINT
  INVENTORY
  IT_SYSTEM
  PROPERTY
  SAFETY
  OTHER
}

enum TicketPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TicketStatus {
  OPEN
  TRIAGED
  ASSIGNED
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  VERIFIED
  CLOSED
  REOPENED
  ESCALATED
}

enum ReporterType {
  GUEST
  TEAM
  MANAGEMENT
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum HousekeepingTaskType {
  CHECKOUT_CLEAN
  ROUTINE
  DEEP_CLEAN
  INSPECTION
}

enum HousekeepingTaskStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
}

model Property {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  address   String
  city      String
  state     String
  country   String
  phone     String
  email     String
  timezone  String
  googleMapsUrl String?
  wifiNetwork   String?
  wifiPassword  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units            Unit[]
  reservations     Reservation[]
  teamMembers      TeamMember[]
  tickets          Ticket[]
  housekeepingTasks HousekeepingTask[]
  hkLocations      HkLocation[]
  inventoryItems   InventoryItem[]
  knowledgeBase    LocationKnowledge?
  agentActionLogs  AgentActionLog[]
}

model Unit {
  id         String     @id @default(cuid())
  propertyId String
  name       String
  type       String
  floor      String
  capacity   Int
  status     UnitStatus @default(AVAILABLE)
  amenities         Json       @default("[]")
  wifiNetwork       String?
  wifiPassword      String?
  gateAccessCode    String?
  doorLockCode      String?
  checkInGuide      String?    @db.Text
  checkOutGuide     String?    @db.Text
  emergencyContacts String?    @db.Text
  googleMapsUrl     String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  property          Property           @relation(fields: [propertyId], references: [id])
  reservations      Reservation[]
  tickets           Ticket[]
  housekeepingTasks HousekeepingTask[]
  hkTurnovers       HkTurnover[]

  @@index([propertyId])
  @@index([status])
}

model Guest {
  id                   String   @id @default(cuid())
  name                 String
  phone                String
  email                String?
  idType               String?
  idNumber             String?
  intellistayGuestId   String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  reservations Reservation[]
  tickets      Ticket[]
  membership   Membership?

  @@index([phone])
  @@index([email])
}

model Reservation {
  id                       String   @id @default(cuid())
  intellistayReservationId String?  @unique
  guestId                  String
  unitId                   String
  propertyId               String
  checkIn                  DateTime
  checkOut                 DateTime
  status                   String
  source                   String
  totalAmount              Float
  bookingNotes             String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  guest    Guest    @relation(fields: [guestId], references: [id])
  unit     Unit     @relation(fields: [unitId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
  @@index([guestId])
  @@index([unitId])
  @@index([status])
  @@index([checkIn])
  @@index([checkOut])
}

model TeamMember {
  id             String   @id @default(cuid())
  name           String
  phone          String
  whatsappNumber String
  role           String
  department     String
  propertyId     String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  property          Property           @relation(fields: [propertyId], references: [id])
  assignedTickets   Ticket[]           @relation("AssignedTickets")
  housekeepingTasks HousekeepingTask[] @relation("AssignedTasks")

  @@index([propertyId])
  @@index([isActive])
}

model Ticket {
  id              String         @id @default(cuid()) // Format RT-XXXX
  propertyId      String
  unitId          String?
  guestId         String?
  inventoryItemId String?
  reporterId      String
  reporterType    ReporterType
  category        TicketCategory
  subcategory     String?
  description     String
  priority        TicketPriority
  status          TicketStatus   @default(OPEN)
  assignedToId    String?
  slaDeadline     DateTime
  responseSlaDeadline DateTime?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  resolutionNotes String?
  attachments     Json           @default("[]")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  property Property @relation(fields: [propertyId], references: [id])
  unit     Unit?    @relation(fields: [unitId], references: [id])
  guest    Guest?   @relation(fields: [guestId], references: [id])
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  assignedTo TeamMember? @relation("AssignedTickets", fields: [assignedToId], references: [id])
  auditLogs TicketAuditLog[]

  @@index([propertyId])
  @@index([inventoryItemId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([assignedToId])
}

model TicketAuditLog {
  id         String   @id @default(cuid())
  ticketId   String
  action     String
  actorId    String
  actorType  String
  fromStatus TicketStatus?
  toStatus   TicketStatus?
  notes      String?
  createdAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
}

model HousekeepingTask {
  id           String                 @id @default(cuid())
  unitId       String
  propertyId   String
  assignedToId String?
  type         HousekeepingTaskType
  status       HousekeepingTaskStatus @default(PENDING)
  scheduledFor DateTime
  startedAt    DateTime?
  completedAt  DateTime?
  photoUrls    Json                   @default("[]")
  notes        String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  unit       Unit        @relation(fields: [unitId], references: [id])
  property   Property    @relation(fields: [propertyId], references: [id])
  assignedTo TeamMember? @relation("AssignedTasks", fields: [assignedToId], references: [id])

  @@index([propertyId])
  @@index([unitId])
  @@index([status])
}

model WhatsAppMessage {
  id               String           @id @default(cuid())
  direction        MessageDirection
  from             String
  to               String
  messageType      String
  content          String
  templateName     String?
  status           String
  relatedEntityType String?
  relatedEntityId   String?
  createdAt        DateTime         @default(now())

  @@index([from])
  @@index([to])
}

model InventoryItem {
  id           String   @id @default(cuid())
  propertyId   String
  name         String
  category     String
  quantity     Int
  unit         String
  minThreshold Int
  defaultDeduction Int @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id])
  tickets  Ticket[]

  @@index([propertyId])
}

model Membership {
  id           String    @id @default(cuid())
  guestId      String    @unique
  tier         String    @default("SILVER")
  points       Int       @default(0)
  referralCode String    @unique @default(cuid())
  referredBy   String?
  joinedAt     DateTime  @default(now())
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  guest Guest @relation(fields: [guestId], references: [id])
  transactions PointTransaction[]
}

model PointTransaction {
  id           String     @id @default(cuid())
  membershipId String
  amount       Int        // Positive for earn, negative for redeem
  type         String     // "JOIN_BONUS", "REFERRAL_BONUS", "REDEMPTION"
  description  String
  createdAt    DateTime   @default(now())

  membership   Membership @relation(fields: [membershipId], references: [id])
  @@index([membershipId])
}

enum SyncStatus {
  SUCCESS
  PARTIAL
  FAILED
}

model SyncLog {
  id              String      @id @default(cuid())
  startedAt       DateTime    @default(now())
  completedAt     DateTime?
  status          SyncStatus
  recordsProcessed Int        @default(0)
  recordsUpdated   Int        @default(0)
  recordsCreated   Int        @default(0)
  error           String?
  source          String      @default("INTELLISTAY")
}

model LocationKnowledge {
  id          String   @id @default(cuid())
  propertyId  String   @unique
  sops        String   @db.Text
  policies    String   @db.Text
  prices      String   @db.Text
  facts       String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property    Property @relation(fields: [propertyId], references: [id])
}

model AgentActionLog {
  id          String   @id @default(cuid())
  agentName   String
  actionType  String
  inputs      Json
  decision    String   @db.Text
  outcome     String   @db.Text
  timestamp   DateTime @default(now())
  propertyId  String?

  property    Property? @relation(fields: [propertyId], references: [id])

  @@index([agentName])
  @@index([actionType])
  @@index([propertyId])
}

// ─────────────────────────────────────────────────────────────
// Housekeeping proof-of-work module (attendance + bonus)
// Separate from HousekeepingTask above: that is the WhatsApp task flow,
// this is the video/geofence checklist flow with its own login.
// ─────────────────────────────────────────────────────────────

enum HkTurnoverStatus {
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
  EXEMPT
}

enum HkMediaKind {
  PHOTO
  VIDEO
}

model HkLocation {
  id         String   @id @default(cuid())
  propertyId String
  name       String
  latitude   Float
  longitude  Float
  radiusM    Int      @default(150)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property    Property              @relation(fields: [propertyId], references: [id])
  assignments HkAssignment[]
  templates   HkChecklistTemplate[]
  turnovers   HkTurnover[]

  @@index([propertyId])
}

model HkUser {
  id             String    @id @default(cuid())
  name           String
  mobile         String    @unique // E.164, e.g. +919876543210
  pinHash        String
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  assignments HkAssignment[]
  turnovers   HkTurnover[]
}

model HkAssignment {
  id         String   @id @default(cuid())
  hkUserId   String
  locationId String
  createdAt  DateTime @default(now())

  hkUser   HkUser     @relation(fields: [hkUserId], references: [id], onDelete: Cascade)
  location HkLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([hkUserId, locationId])
  @@index([locationId])
}

model HkChecklistTemplate {
  id         String   @id @default(cuid())
  locationId String
  title      String
  unitType   String? // matches Unit.type, e.g. "Studio"; null = any unit at the location
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  location  HkLocation        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  areas     HkChecklistArea[]
  turnovers HkTurnover[]

  @@index([locationId])
}

model HkChecklistArea {
  id             String   @id @default(cuid())
  templateId     String
  title          String
  sortOrder      Int      @default(0)
  instructions   String?  @db.Text
  minPhotos      Int      @default(1)
  requiresVideo  Boolean  @default(true)
  referenceMedia Json     @default("[]") // [{ url, kind: "PHOTO" | "VIDEO" }]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  template    HkChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  submissions HkSubmission[]

  @@index([templateId])
}

model HkTurnover {
  id                String           @id @default(cuid())
  unitId            String
  locationId        String
  hkUserId          String
  templateId        String
  status            HkTurnoverStatus @default(IN_PROGRESS)
  checkInAt         DateTime         @default(now())
  checkInLat        Float
  checkInLng        Float
  checkInAccuracyM  Float?
  checkOutAt        DateTime?
  checkOutLat       Float?
  checkOutLng       Float?
  checkOutAccuracyM Float?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  unit        Unit                @relation(fields: [unitId], references: [id])
  location    HkLocation          @relation(fields: [locationId], references: [id])
  hkUser      HkUser              @relation(fields: [hkUserId], references: [id])
  template    HkChecklistTemplate @relation(fields: [templateId], references: [id])
  submissions HkSubmission[]

  @@index([hkUserId, checkInAt])
  @@index([locationId, checkInAt])
  @@index([unitId])
  @@index([status])
}

model HkSubmission {
  id               String      @id @default(cuid())
  turnoverId       String
  areaId           String
  kind             HkMediaKind
  mediaUrl         String
  mimeType         String?
  sizeBytes        Int?
  durationSec      Int?
  capturedAtClient DateTime
  receivedAt       DateTime    @default(now())
  latitude         Float?
  longitude        Float?
  accuracyM        Float?

  turnover HkTurnover      @relation(fields: [turnoverId], references: [id], onDelete: Cascade)
  area     HkChecklistArea @relation(fields: [areaId], references: [id])

  @@index([turnoverId])
  @@index([areaId])
}
