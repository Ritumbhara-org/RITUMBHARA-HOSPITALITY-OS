generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UnitStatus {
  AVAILABLE
  OCCUPIED
  DIRTY
  CLEANING
  READY
  MAINTENANCE
}

enum TicketCategory {
  MAINTENANCE
  HOUSEKEEPING
  GUEST_REQUEST
  GUEST_COMPLAINT
  INVENTORY
  IT_SYSTEM
  PROPERTY
  SAFETY
  OTHER
}

enum TicketPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TicketStatus {
  OPEN
  TRIAGED
  ASSIGNED
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  VERIFIED
  CLOSED
  REOPENED
  ESCALATED
}

enum ReporterType {
  GUEST
  TEAM
  MANAGEMENT
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum HousekeepingTaskType {
  CHECKOUT_CLEAN
  ROUTINE
  DEEP_CLEAN
  INSPECTION
}

enum HousekeepingTaskStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
}

model Property {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  address   String
  city      String
  state     String
  country   String
  phone     String
  email     String
  timezone  String
  googleMapsUrl String?
  wifiNetwork   String?
  wifiPassword  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units            Unit[]
  reservations     Reservation[]
  teamMembers      TeamMember[]
  tickets          Ticket[]
  housekeepingTasks HousekeepingTask[]
  inventoryItems   InventoryItem[]
  knowledgeBase    LocationKnowledge?
  agentActionLogs  AgentActionLog[]
  inboxConversations InboxConversation[]
  longStayBookings LongStayBooking[]
}

model Unit {
  id         String     @id @default(cuid())
  propertyId String
  name       String
  type       String
  floor      String
  capacity   Int
  status     UnitStatus @default(AVAILABLE)
  amenities         Json       @default("[]")
  wifiNetwork       String?
  wifiPassword      String?
  gateAccessCode    String?
  doorLockCode      String?
  checkInGuide      String?    @db.Text
  checkOutGuide     String?    @db.Text
  emergencyContacts String?    @db.Text
  googleMapsUrl     String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  property          Property           @relation(fields: [propertyId], references: [id])
  reservations      Reservation[]
  tickets           Ticket[]
  housekeepingTasks HousekeepingTask[]
  longStayBookings  LongStayBooking[]

  @@index([propertyId])
  @@index([status])
}

model Guest {
  id                   String   @id @default(cuid())
  name                 String
  phone                String
  email                String?
  idType               String?
  idNumber             String?
  intellistayGuestId   String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  reservations Reservation[]
  tickets      Ticket[]
  membership   Membership?
  inboxConversations InboxConversation[]

  @@index([phone])
  @@index([email])
}

model Reservation {
  id                       String   @id @default(cuid())
  intellistayReservationId String?  @unique
  guestId                  String
  unitId                   String
  propertyId               String
  checkIn                  DateTime
  checkOut                 DateTime
  status                   String
  source                   String
  totalAmount              Float
  bookingNotes             String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  guest    Guest    @relation(fields: [guestId], references: [id])
  unit     Unit     @relation(fields: [unitId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
  inboxConversations InboxConversation[]

  @@index([propertyId])
  @@index([guestId])
  @@index([unitId])
  @@index([status])
  @@index([checkIn])
  @@index([checkOut])
}

model TeamMember {
  id             String   @id @default(cuid())
  name           String
  phone          String
  whatsappNumber String
  role           String
  department     String
  propertyId     String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  property          Property           @relation(fields: [propertyId], references: [id])
  assignedTickets   Ticket[]           @relation("AssignedTickets")
  housekeepingTasks HousekeepingTask[] @relation("AssignedTasks")
  inboxConversations InboxConversation[] @relation("InboxAssignee")
  inboxMessagesSent  InboxMessage[]      @relation("InboxSender")

  @@index([propertyId])
  @@index([isActive])
}

model Ticket {
  id              String         @id @default(cuid()) // Format RT-XXXX
  propertyId      String
  unitId          String?
  guestId         String?
  inventoryItemId String?
  reporterId      String
  reporterType    ReporterType
  category        TicketCategory
  subcategory     String?
  description     String
  priority        TicketPriority
  status          TicketStatus   @default(OPEN)
  assignedToId    String?
  slaDeadline     DateTime
  responseSlaDeadline DateTime?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  resolutionNotes String?
  attachments     Json           @default("[]")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  property Property @relation(fields: [propertyId], references: [id])
  unit     Unit?    @relation(fields: [unitId], references: [id])
  guest    Guest?   @relation(fields: [guestId], references: [id])
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  assignedTo TeamMember? @relation("AssignedTickets", fields: [assignedToId], references: [id])
  auditLogs TicketAuditLog[]

  @@index([propertyId])
  @@index([inventoryItemId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([assignedToId])
}

model TicketAuditLog {
  id         String   @id @default(cuid())
  ticketId   String
  action     String
  actorId    String
  actorType  String
  fromStatus TicketStatus?
  toStatus   TicketStatus?
  notes      String?
  createdAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
}

model HousekeepingTask {
  id           String                 @id @default(cuid())
  unitId       String
  propertyId   String
  assignedToId String?
  type         HousekeepingTaskType
  status       HousekeepingTaskStatus @default(PENDING)
  scheduledFor DateTime
  startedAt    DateTime?
  completedAt  DateTime?
  photoUrls    Json                   @default("[]")
  notes        String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  unit       Unit        @relation(fields: [unitId], references: [id])
  property   Property    @relation(fields: [propertyId], references: [id])
  assignedTo TeamMember? @relation("AssignedTasks", fields: [assignedToId], references: [id])

  @@index([propertyId])
  @@index([unitId])
  @@index([status])
}

model WhatsAppMessage {
  id               String           @id @default(cuid())
  direction        MessageDirection
  from             String
  to               String
  messageType      String
  content          String
  templateName     String?
  status           String
  relatedEntityType String?
  relatedEntityId   String?
  createdAt        DateTime         @default(now())

  @@index([from])
  @@index([to])
}

enum InboxChannel {
  WHATSAPP
  AIRBNB
  BOOKING_COM
  AGODA
  EXPEDIA
  MAKEMYTRIP
  EMAIL
}

enum InboxConversationStatus {
  OPEN
  CLOSED
}

// One guest conversation in the unified inbox, whatever channel it came from.
// WhatsApp threads keep their messages in WhatsAppMessage and use this row only
// for team state (assignee, status, read). Other channels store messages in InboxMessage.
model InboxConversation {
  id                 String                  @id @default(cuid())
  channel            InboxChannel
  externalThreadId   String                  // phone for WhatsApp, OTA reservation code or email thread key otherwise
  subject            String?
  guestName          String?
  guestContact       String?
  replyTo            String?                 // OTA relay / email address replies are sent to
  propertyId         String?
  reservationId      String?
  guestId            String?
  assigneeId         String?
  status             InboxConversationStatus @default(OPEN)
  lastMessageAt      DateTime                @default(now())
  lastMessagePreview String?
  lastInboundAt      DateTime?
  lastReadAt         DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  property    Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  reservation Reservation?   @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guest       Guest?         @relation(fields: [guestId], references: [id], onDelete: SetNull)
  assignee    TeamMember?    @relation("InboxAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages    InboxMessage[]

  @@unique([channel, externalThreadId])
  @@index([status])
  @@index([lastMessageAt])
  @@index([assigneeId])
  @@index([reservationId])
}

model InboxMessage {
  id                String           @id @default(cuid())
  conversationId    String
  direction         MessageDirection
  body              String           @db.Text
  senderName        String?
  sentById          String?
  externalMessageId String?          @unique
  status            String           @default("RECEIVED")
  raw               Json?
  createdAt         DateTime         @default(now())

  conversation InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sentBy       TeamMember?       @relation("InboxSender", fields: [sentById], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

model InventoryItem {
  id           String   @id @default(cuid())
  propertyId   String
  name         String
  category     String
  quantity     Int
  unit         String
  minThreshold Int
  defaultDeduction Int @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id])
  tickets  Ticket[]

  @@index([propertyId])
}

model Membership {
  id           String    @id @default(cuid())
  guestId      String    @unique
  tier         String    @default("SILVER")
  points       Int       @default(0)
  referralCode String    @unique @default(cuid())
  referredBy   String?
  joinedAt     DateTime  @default(now())
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  guest Guest @relation(fields: [guestId], references: [id])
  transactions PointTransaction[]
}

model PointTransaction {
  id           String     @id @default(cuid())
  membershipId String
  amount       Int        // Positive for earn, negative for redeem
  type         String     // "JOIN_BONUS", "REFERRAL_BONUS", "REDEMPTION"
  description  String
  createdAt    DateTime   @default(now())

  membership   Membership @relation(fields: [membershipId], references: [id])
  @@index([membershipId])
}

enum SyncStatus {
  SUCCESS
  PARTIAL
  FAILED
}

model SyncLog {
  id              String      @id @default(cuid())
  startedAt       DateTime    @default(now())
  completedAt     DateTime?
  status          SyncStatus
  recordsProcessed Int        @default(0)
  recordsUpdated   Int        @default(0)
  recordsCreated   Int        @default(0)
  error           String?
  source          String      @default("INTELLISTAY")
}

// The admin's notification feed (the bell in the top bar): new guest messages, bookings, tickets and failures
// that someone needs to look at. One shared feed, because the OS has a single admin sign-in.
// Repeated events about the same thing (e.g. several WhatsApp messages from one guest) collapse into one
// unread row via groupKey, with `count` showing how many.
model AdminNotification {
  id         String    @id @default(cuid())
  type       String                       // e.g. WHATSAPP_MESSAGE, OTA_MESSAGE, BOOKING_CREATED, TICKET_CREATED, SLA_BREACHED
  severity   String    @default("INFO")   // INFO | ACTION | CRITICAL
  title      String
  body       String?   @db.Text
  href       String?                      // where "take action" leads, always a path inside the OS
  groupKey   String?
  count      Int       @default(1)
  propertyId String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([readAt, createdAt])
  @@index([groupKey, readAt])
}

// One row per phone or browser the admin turned phone alerts on for (web push). The OS has a single admin
// sign-in, so every subscription belongs to that admin. A row is removed when the push service says it is gone.
model PushSubscription {
  id         String   @id @default(cuid())
  endpoint   String   @unique @db.Text
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model LocationKnowledge {
  id          String   @id @default(cuid())
  propertyId  String   @unique
  sops        String   @db.Text
  policies    String   @db.Text
  prices      String   @db.Text
  facts       String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property    Property @relation(fields: [propertyId], references: [id])
}

model AgentActionLog {
  id          String   @id @default(cuid())
  agentName   String
  actionType  String
  inputs      Json
  decision    String   @db.Text
  outcome     String   @db.Text
  timestamp   DateTime @default(now())
  propertyId  String?

  property    Property? @relation(fields: [propertyId], references: [id])

  @@index([agentName])
  @@index([actionType])
  @@index([propertyId])
}

// ---------- Long Stays: monthly / extended bookings made directly by the team ----------

enum LongStayStatus {
  UPCOMING
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum LongStayInclusion {
  UNIT_ONLY
  UNIT_ELECTRICITY
  UNIT_ELECTRICITY_MAINTENANCE
  ALL_INCLUSIVE
}

enum LongStayRateType {
  PER_NIGHT
  PER_MONTH
}

enum LongStayAgreementStatus {
  SENT
  VIEWED
  SIGNED
  VOIDED
}

model LongStayBooking {
  id                String             @id @default(cuid())
  status            LongStayStatus     @default(UPCOMING)
  guestName         String
  contactNumber     String
  altContactNumber  String?
  email             String?
  occupants         Int                @default(1)
  emergencyContact  String?
  idType            String
  idNumber          String
  propertyId        String
  unitId            String?
  propertyType      String
  checkIn           DateTime           @db.Date
  checkOut          DateTime           @db.Date
  nights            Int
  inclusion         LongStayInclusion
  rateType          LongStayRateType   @default(PER_MONTH)
  rate              Float              @default(0)
  totalAmount       Float              @default(0)
  advancePaid       Float              @default(0)
  paymentMode       String?
  securityDeposit   Float              @default(0)
  depositMode       String?
  depositTerms      String             @db.Text
  termsAccepted     Boolean            @default(false)
  depositDeduction  Float              @default(0)
  deductionReason   String?
  depositRefundedOn DateTime?          @db.Date
  idDocuments       String[]           @default([])
  checkInMedia      String[]           @default([])
  checkOutMedia     String[]           @default([])
  notes             String?            @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  property   Property            @relation(fields: [propertyId], references: [id])
  unit       Unit?               @relation(fields: [unitId], references: [id], onDelete: SetNull)
  agreements LongStayAgreement[]

  @@index([propertyId])
  @@index([unitId])
  @@index([status])
  @@index([checkIn])
}

// One e-sign request for a booking. Only a hash of the link token and of the OTP is stored.
model LongStayAgreement {
  id              String                  @id @default(cuid())
  bookingId       String
  status          LongStayAgreementStatus @default(SENT)
  tokenHash       String                  @unique
  snapshot        Json
  snapshotHash    String
  sentVia         String                  @default("LINK")
  sentAt          DateTime                @default(now())
  expiresAt       DateTime
  viewedAt        DateTime?
  otpHash         String?
  otpExpiresAt    DateTime?
  otpAttempts     Int                     @default(0)
  otpSendCount    Int                     @default(0)
  otpLastSentAt   DateTime?
  lockedAt        DateTime?
  phoneVerified   String?
  phoneVerifiedAt DateTime?
  signedAt        DateTime?
  signerName      String?
  signaturePath   String?
  signerIp        String?
  signerUserAgent String?
  pdfPath         String?
  voidedAt        DateTime?
  voidReason      String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  booking LongStayBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
}
